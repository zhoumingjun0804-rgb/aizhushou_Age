# 服务端口
PORT=8000

# Lovart 龙虾 OpenAPI（主 Key，必填方可生图）
# LOVART_ACCESS_KEY=ak_xxx
# LOVART_SECRET_KEY=sk_xxx
# 备用 Key：主 Key 并发或额度受限时自动切换（可继续 _3、_4…）
# LOVART_ACCESS_KEY_2=ak_xxx
# LOVART_SECRET_KEY_2=sk_xxx
# 或批量：LOVART_ACCESS_KEYS=ak1,ak2 与 LOVART_SECRET_KEYS=sk1,sk2（顺序一一对应）
LOVART_BASE_URL=https://lgw.lovart.ai
# macOS 若报 CERTIFICATE_VERIFY_FAILED，项目已用 certifi 兜底；仍失败可设 1 跳过校验（仅本机开发）
# LOVART_INSECURE_SSL=1
# 未选本地项目组时，全部生图归入该 Lovart 项目（可选）
# LOVART_DEFAULT_PROJECT_ID=
# 本地项目组绑定：projects/<组名>/project.json 内 lovart_project_id（可填 Lovart 网页已有项目 ID）
# Lovart 单张最长等待秒数；3 张串行时总耗时约为 3 倍
LOVART_POLL_TIMEOUT=300
# Lovart 建议 1，避免多任务同时排队导致超时
LOVART_MAX_CONCURRENCY=1
# 遇到 Concurrent task limit 时的重试次数与间隔（秒）
LOVART_TASK_RETRY=5
LOVART_TASK_RETRY_WAIT=15
LOVART_MODE=fast
LOVART_QUALITY_HINT=适合手机屏幕与网页展示，宽度约1200到1536像素，细节清晰但不必4K

# 项目组目录（默认使用项目根目录下的 projects）
# PROJECTS_DIR=/path/to/projects

# 至少配置一个大模型 Key，用于 AI 关键词分析
# DEEPSEEK_API_KEY=
# QIANWEN_API_KEY=
# KIMI_API_KEY=
# DOUBAO_API_KEY=
