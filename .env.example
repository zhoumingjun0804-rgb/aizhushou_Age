# 服务端口
PORT=8000

# 生图后端：lovart（交付版默认，仅 Lovart）/ dreamina / comfyui / stable_diffusion
IMAGE_BACKEND=lovart

# 项目组门禁：1=开启（须密码解锁）；0=关闭（下拉选项目组，API 不校验 token）
PROJECT_GATE_ENABLED=0
# 门禁开启时生效的密码
PROJECT_PASSWORD_HLL=hll2026
PROJECT_PASSWORD_XDT=xdt2026

# GPT — 按项目组配置（生图 + GPT 润色共用 OPENAI_API_KEY_*，禁止无后缀回落）
# 小灯塔：
# OPENAI_IMAGE_PROVIDER_XDT=azure
# OPENAI_API_KEY_XDT=your-xdt-api-key-hex
# OPENAI_IMAGE_BASE_URL_XDT=https://liuyi-llm-risk.61info.cn/api/gptproto
# OPENAI_CHAT_MODEL_XDT=gpt-5.4
# 画啦啦：
# OPENAI_IMAGE_PROVIDER_HLL=azure
# OPENAI_API_KEY_HLL=your-hll-api-key-hex
# OPENAI_IMAGE_BASE_URL_HLL=https://liuyi-llm-risk.61info.cn/api/gptproto
# OPENAI_CHAT_MODEL_HLL=gpt-5.4
# 官方 OpenAI（可选）：OPENAI_IMAGE_PROVIDER_*=official + sk-proj-...
# OPENAI_IMAGE_MODEL_FAST=gpt-image-1-mini
# OPENAI_IMAGE_MODEL_BALANCED=gpt-image-1.5
# OPENAI_IMAGE_MODEL_QUALITY=gpt-image-2
# gpt-image-2 生图质量：low / medium / high / auto（默认 medium，速度与画质平衡）
OPENAI_IMAGE_OUTPUT_QUALITY=medium

# Lovart 龙虾 OpenAPI — 仅画啦啦（_HLL）；小灯塔已停用 Lovart，仅用 GPT 生图
# 禁止再用无后缀 LOVART_ACCESS_KEY
LOVART_ACCESS_KEY_HLL=
LOVART_SECRET_KEY_HLL=
# 已忽略（保留变量名兼容旧 .env，代码侧不会加载）
# LOVART_ACCESS_KEY_XDT=
# LOVART_SECRET_KEY_XDT=
# 同组内备用（仅在该项目组额度不足时轮换，不得跨组混用）
# LOVART_ACCESS_KEY_HLL_2=ak_xxx
# LOVART_SECRET_KEY_HLL_2=sk_xxx
LOVART_BASE_URL=https://lgw.lovart.ai
# macOS 若报 CERTIFICATE_VERIFY_FAILED，项目已用 certifi 兜底；仍失败可设 1 跳过校验（仅本机开发）
# LOVART_INSECURE_SSL=1
# 未选本地项目组时，全部生图归入该 Lovart 项目（可选）
# LOVART_DEFAULT_PROJECT_ID=
# 本地项目组绑定：projects/<组名>/project.json 内 lovart_project_id（可填 Lovart 网页已有项目 ID）
# Lovart 单张最长等待秒数；3 张串行时总耗时约为 3 倍
LOVART_POLL_TIMEOUT=300
# Lovart 建议 1，避免多任务同时排队导致超时
LOVART_MAX_CONCURRENCY=1
# 生图队列：全局排队上限、内存任务保留、整单超时、ETA 粗估（秒/张）
LOVART_QUEUE_MAX=20
LOVART_JOB_TTL=3600
LOVART_JOB_MAX_SECONDS=1800
LOVART_ETA_AVG_SECONDS=90
# GPT 生图队列（与 Lovart 分池；MAX_CONCURRENCY 同时是全站 GPT API 上限）
GPT_MAX_CONCURRENCY=4
GPT_QUEUE_MAX=20
GPT_ETA_AVG_SECONDS=45
GPT_VARIANT_PARALLEL=4
# 遇到 Concurrent task limit 时的重试次数与间隔（秒）
LOVART_TASK_RETRY=5
LOVART_TASK_RETRY_WAIT=15
LOVART_MODE=fast
# 无限低速：auto=快信用用尽后自动 set-mode --unlimited；1=始终无限低速（有套餐时用）
# LOVART_UNLIMITED=auto
LOVART_QUALITY_HINT=适合手机屏幕与网页展示，宽度约1200到1536像素，细节清晰但不必4K

# ComfyUI（需本地已启动，并填写模型文件名）
COMFYUI_API_URL=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors

# Stable Diffusion WebUI（Automatic1111）
SD_API_URL=http://127.0.0.1:7860
LOCAL_GENERATION_TIMEOUT=180

# 即梦 CLI 路径（留空则自动从 PATH 查找 dreamina）
# DREAMINA_BIN=/path/to/dreamina

# GIF 转 SVGA：始终与原 GIF 同宽高；体积上限（字节），默认 1048576=1MB，0=不限制
# SVGA_MAX_BYTES=1048576

# 项目组目录（默认使用项目根目录下的 projects）
# PROJECTS_DIR=/path/to/projects

# AI 关键词润色 — 按项目组（DeepSeek 兼容接口；各组必填 DEEPSEEK_API_KEY_*）
DEEPSEEK_API_KEY_HLL=
DEEPSEEK_API_KEY_XDT=
# 公司 AgentHub：DEEPSEEK_BASE_URL=https://agenthub.vipthink.cn（外网需 VPN）
# DEEPSEEK_MODEL=claude-haiku-4-5-20251001
# 直连 DeepSeek 官方：DEEPSEEK_BASE_URL=https://api.deepseek.com 且 DEEPSEEK_MODEL=deepseek-chat
# QIANWEN_API_KEY_HLL=  QIANWEN_API_KEY_XDT=
# KIMI_API_KEY_HLL=  KIMI_API_KEY_XDT=
# DOUBAO_API_KEY_HLL=  DOUBAO_API_KEY_XDT=
# 智能抠图视觉分析（需豆包视觉模型，未配置时仅用关键词推断）
# DOUBAO_VISION_MODEL=doubao-1-5-vision-pro-32k-250115

# 远程部署（./deploy.sh remote，本机需 sshpass + rsync）
# TEST_SERVICE_URL=your-server.example.com
# TEST_ACCOUNT=deploy_user
# TEST_PASSWORD=your_ssh_password

# 测试机经代理访问 Lovart（直连失败时配置，会同步到远端）
# HTTP_PROXY=http://proxy.example.com:1080
# HTTPS_PROXY=http://proxy.example.com:1080
# http_proxy=http://proxy.example.com:1080
# https_proxy=http://proxy.example.com:1080
# 内网网关（61info.cn / AgentHub）勿走 Lovart 用的外网代理：
# NO_PROXY=127.0.0.1,localhost,.61info.cn,61info.cn,agenthub.vipthink.cn
# no_proxy=127.0.0.1,localhost,.61info.cn,61info.cn,agenthub.vipthink.cn
