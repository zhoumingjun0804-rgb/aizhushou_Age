# 项目组门禁：0=关闭；1=开启（须密码解锁）

# Lovart 龙虾 OpenAPI — 按项目组（画啦啦=原主 Key，小灯塔=原 _2）
LOVART_ACCESS_KEY_HLL=ak_a020b75f36a06b98989f98a3332a74a7
LOVART_SECRET_KEY_HLL=sk_340da32b1baabc9018b8be3de0dfb93fd218c96c25cd41fbd5b17a6af0c908bb

LOVART_ACCESS_KEY_XDT=ak_51795d94e127de5a8034125179432d74
LOVART_SECRET_KEY_XDT=sk_5d2dcf6c069ddf369075551210bdbb78e2b4780792e141959b9b23512da10382

LOVART_ACCESS_KEY_XDT_2=ak_852f4a68ee9cc4e62d0832cccf880389
LOVART_SECRET_KEY_XDT_2=sk_53ebee7c658f5c4c1249c2c968c6c5a92be02dd08fcc456d7a8ea94913cec7d5
# 废弃（实现验收后可删）：LOVART_ACCESS_KEY / LOVART_ACCESS_KEY_2
# LOVART_ACCESS_KEY=ak_a020b75f36a06b98989f98a3332a74a7
# LOVART_SECRET_KEY=sk_340da32b1baabc9018b8be3de0dfb93fd218c96c25cd41fbd5b17a6af0c908bb
# LOVART_ACCESS_KEY_2=ak_852f4a68ee9cc4e62d0832cccf880389
